---
import "../styles/globals.scss";
import css from "./index.module.scss";
import SinglePriceGridComponent from "../components/SinglePriceGridComponent.astro";

const title = "Frontend Mentor | Single Price Grid Component";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class={css.body}>
    <header class={css.header}>
      <h1>{title}</h1>
    </header>

    <main class={css.main}>
      <SinglePriceGridComponent />
    </main>
  </body>
</html>
